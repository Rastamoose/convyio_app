{
  "name": "human-agent-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client,agent -c blue,green,magenta \"npm run dev -w @workspace/server\" \"npm run dev -w @workspace/client\" \"npm run dev:agent\"",
    "dev:server": "npm run dev -w @workspace/server",
    "dev:client": "npm run dev -w @workspace/client",
    "dev:agent": "tsx watch packages/agent/src/index.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
