# Copy to .env and fill in what you use. Compose hands this file to the
# container; bare-metal runs read it via the agent's dotenv / your shell.
# Never commit the real .env.

# --- Agent (optional — without a key the workspace runs with no AI agent) ---
# GEMINI_API_KEY=your-gemini-api-key
# AGENT_NAME=noodle
# AGENT_MODEL=gemini-2.5-flash

# --- Google Sign-In (optional — unset = guest mode, anyone picks a name) ---
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Long random secret the agent presents to join an auth-enabled server:
#   openssl rand -hex 32
# AGENT_TOKEN=

# --- Server (container defaults are fine; see DEPLOY.md for the full table) ---
# PORT=3001
# DATA_DIR=/data
