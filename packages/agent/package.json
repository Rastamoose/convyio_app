{
  "name": "@workspace/agent",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "convyio-agent": "dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --banner:js=\"import { createRequire as __convyRequire } from 'node:module';const require = __convyRequire(import.meta.url);\" --outfile=dist/cli.js && chmod 755 dist/cli.js",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/index.ts",
    "dev:cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.64.2"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@google/genai": "^0.10.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "@workspace/shared": "*",
    "dotenv": "^17.4.2",
    "openai": "^7.5.0",
    "tsx": "^4.23.5",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  }
}
